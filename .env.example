# Sustitúyelo por `openssl rand -base64 32` (≥ 32 bytes aleatorios). Este valor
# de ejemplo solo se admite fuera de producción, con un aviso (ADR 016).
AUTH_SECRET=generate-with-openssl-rand-base64-32
# AUTH_URL es obligatorio; en producción debe ser una URL https:// (origen público
# de la app). AUTH_TRUST_HOST sin AUTH_URL se rechaza: los enlaces saldrían de la
# cabecera Host de la petición.
AUTH_URL=http://localhost:3000
# Dev: leave EMAIL unset to log magic links to server console.
# Producción: EMAIL_SERVER es obligatorio (el servidor no arranca sin él).
# EMAIL_SERVER=smtp://...
# EMAIL_FROM=Listae <noreply@localhost>
# TMDB v3 API Key (query) or v4 Read Access Token (JWT / Bearer) both work
TMDB_API_KEY=
DATABASE_URL=file:./data/listae.db
# IP del cliente para los rate limits (ADR 014). Sin ninguna de las dos, la IP es
# desconocida: las búsquedas anónimas comparten un cubo (300/h) y el login solo se
# limita por email. Nunca se confía en lo que manda el cliente.
# Producción: proxy inverso que SOBRESCRIBE X-Real-IP con la IP del socket
# (nginx: proxy_set_header X-Real-IP $remote_addr;). Sin ese proxy, no lo actives:
# el cliente podría inventarse la cabecera.
# CLIENT_IP_HEADER=x-real-ip
# Alternativa: nº de proxies de confianza que AÑADEN a X-Forwarded-For (se cuenta
# desde la derecha). Se ignora si CLIENT_IP_HEADER está definido.
# TRUSTED_PROXY_HOPS=1
